# ---------------------------------------------------------------------------
# UINexus — variables de entorno
#
# Copia este archivo a .env.local y rellena los valores.
# Si dejas vacía la configuración, UINexus arranca en MODO DEMO con datos de
# ejemplo en memoria (útil para revisar la interfaz sin infraestructura).
#
# Reparto de responsabilidades tras la migración a AWS:
#   Firebase  ->  SÓLO autenticación (quién eres)
#   AWS       ->  datos (DynamoDB), archivos (S3) y origen aislado (Lambda)
# ---------------------------------------------------------------------------

# --- Firebase Web SDK (público, seguro de exponer al navegador) ---
# Identifica el proyecto; no autoriza nada. La seguridad real está en la
# verificación del ID token en servidor y en las políticas de IAM.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin SDK (SECRETO) ---
# En AWS no existen las credenciales por defecto de Google, así que esto es
# OBLIGATORIO en producción: sin ello el servidor no puede verificar tokens y
# todas las escrituras quedan cerradas.
# Va en el gestor de secretos de Amplify. NUNCA en el repositorio.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Alternativa sólo para desarrollo local:
GOOGLE_APPLICATION_CREDENTIALS=

# --- AWS ---
# En local las credenciales las resuelve `aws configure` (~/.aws/credentials) y
# en Amplify el rol de ejecución del backend: en esos dos casos, deja lo de
# abajo vacío.
#
# En VERCEL no hay rol, así que hay que darlas. Y tienen nombre propio a
# propósito: las funciones de Vercel corren sobre Lambda, que ya define
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY con la identidad de Vercel. Si
# usáramos esos nombres, las peticiones se firmarían con una identidad ajena y
# DynamoDB respondería AccessDenied.
#
# Usa un usuario IAM dedicado, acotado a las tablas y buckets de la pila.
# En Vercel, ambas como variables cifradas (Sensitive).
UINEXUS_AWS_REGION=us-east-1
UINEXUS_AWS_ACCESS_KEY_ID=
UINEXUS_AWS_SECRET_ACCESS_KEY=
# Sólo si usas credenciales temporales (STS):
UINEXUS_AWS_SESSION_TOKEN=

# Valores que devuelve `npm run aws:outputs` tras desplegar la pila.
UINEXUS_TABLE_PREFIX=uinexus
UINEXUS_PROJECTS_BUCKET=
UINEXUS_PUBLIC_BUCKET=
UINEXUS_PUBLIC_BASE_URL=

# Mapa de rutas del origen aislado (CloudFront KeyValueStore). El servidor lo
# actualiza al publicar; si un proyecto no esta aqui, es inalcanzable.
UINEXUS_ROUTES_KVS_ARN=

# --- Orígenes ---
# Dominio de la plataforma (metadata social/académica).
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
# Alias anterior, todavía aceptado para despliegues existentes:
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Origen AISLADO donde se EJECUTA el contenido de los alumnos.
# En producción DEBE ser un dominio REGISTRABLE distinto, no un subdominio:
# un subdominio todavía puede escribir cookies sobre el dominio padre.
# Es el dominio de CloudFront que devuelve `npm run aws:outputs`.
NEXT_PUBLIC_PROJECTS_ORIGIN=

# --- Emuladores de Firebase (sólo Auth) ---
# Se activa con una variable explícita, nunca por heurística de NODE_ENV.
NEXT_PUBLIC_FIREBASE_USE_EMULATORS=false
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1

# --- App Check (opcional, defensa en profundidad) ---
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=
